# ArthSahayak Backend Environment Configuration

# 1. Speech Transcription (Groq Whisper)
# Required for real multilingual voice transcription via POST /voice/transcribe
# Get key from: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Groq Whisper model (default: whisper-large-v3)
GROQ_WHISPER_MODEL=whisper-large-v3

# 2. Transaction Extraction & Document OCR (Google Gemini)
# Required for real AI extraction and handwritten ledger OCR
# Get key from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model override (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# 3. CORS Configuration
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://arth-sahayak.vercel.app

# 4. Offline / Stub Testing Mode
# Set to 'true' ONLY to run offline with fake test responses when no API keys are configured.
# In production, leave false or unset so missing keys return explicit 503 errors.
ALLOW_STUB_PROVIDERS=false
