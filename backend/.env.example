# ArthSahayak Backend Environment Configuration

# 1. Voice Pipeline: Speech Transcription & LLM Structured Extraction (Groq)
# Required for real multilingual voice transcription and fast JSON extraction
# Get key from: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Groq models (defaults: whisper-large-v3, llama-3.1-8b-instant)
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_EXTRACTION_MODEL=llama-3.1-8b-instant

# 2. Document & Chit OCR (Google Gemini Vision)
# Required for real handwritten ledger and chit OCR via POST /ocr/extract
# Get key from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model override for OCR (default: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# 3. CORS Configuration
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://arth-sahayak.vercel.app

# 4. Offline / Stub Testing Mode
# Set to 'true' ONLY to run offline with fake test responses when no API keys are configured.
# In production, leave false or unset so missing keys return explicit 503 errors.
ALLOW_STUB_PROVIDERS=false
